# Template de variables de entorno. Copiá a ".env" y completá con tus valores.
# El archivo .env está en .gitignore: NUNCA comitees secretos.

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- PostgreSQL (metastore de Airflow) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Airflow ---
# Clave secreta del webserver (usá un valor largo y aleatorio)
AIRFLOW__WEBSERVER__SECRET_KEY=
# Usuario admin que crea "airflow standalone"
AIRFLOW_WWW_USER_USERNAME=
AIRFLOW_WWW_USER_PASSWORD=

# --- Conexión S3 / MinIO desde los scripts Python ---
# Para ejecutar scripts en tu máquina local fuera de Docker usa localhost:9000
# (Dentro del contenedor de Airflow, docker-compose.yml ya define automáticamente http://minio:9000)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
# Opcional: si preferís credenciales AWS estándar en vez de MINIO_ROOT_*
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
